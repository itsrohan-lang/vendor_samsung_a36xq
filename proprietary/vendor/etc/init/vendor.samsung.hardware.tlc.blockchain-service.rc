service vendor.samsung.hardware.tlc.blockchain-default /vendor/bin/hw/vendor.samsung.hardware.tlc.blockchain-service
    interface aidl vendor.samsung.hardware.tlc.blockchain.ISehBlockchain/default
    class hal
    user system
    group system
    disabled

on property:init.svc.zygote=restarting
    stop vendor.samsung.hardware.tlc.blockchain-default